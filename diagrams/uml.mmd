classDiagram
    %% Draft UML (pre-implementation). Update to match the final code.

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class Owner {
        +str name
        +int available_minutes
        +int day_start_minute
        +dict preferences
        +List~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(name: str) None
        +get_pet(name: str) Pet
        +get_all_tasks() List~Task~
        +get_pending_tasks() List~Task~
    }

    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task_id: str) None
        +get_pending_tasks() List~Task~
    }

    class Task {
        +str id
        +str title
        +str description
        +int duration_minutes
        +Priority priority
        +Frequency frequency
        +int preferred_minute
        +bool completed
        +str pet_name
        +is_recurring() bool
        +mark_complete() None
        +reset() None
    }

    class Scheduler {
        +Owner owner
        +tasks_by_pet() Dict~str, List~Task~~
        +build_plan() DailyPlan
        -_sort_tasks(tasks: List~Task~) List~Task~
    }

    class ScheduledItem {
        +Task task
        +int start_minute
        +str reason
    }

    class SkippedItem {
        +Task task
        +str reason
    }

    class DailyPlan {
        +List~ScheduledItem~ items
        +List~SkippedItem~ skipped
        +total_minutes() int
        +explain() str
    }

    Owner "1" *-- "1..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Task --> Priority : has
    Task --> Frequency : repeats
    Scheduler --> Owner : reads constraints from
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" *-- "0..*" ScheduledItem : contains
    DailyPlan "1" *-- "0..*" SkippedItem : contains
    ScheduledItem --> Task : wraps
    SkippedItem --> Task : wraps
