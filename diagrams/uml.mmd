classDiagram
    %% Draft UML (pre-implementation). Update to match the final code.

    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +List~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() List~Task~
    }

    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +bool completed
        +mark_complete() None
    }

    class Scheduler {
        +Owner owner
        +build_plan() DailyPlan
        -sort_tasks(tasks: List~Task~) List~Task~
        -fits_in_time(task: Task, remaining: int) bool
    }

    class ScheduledItem {
        +Task task
        +str start_time
        +str reason
    }

    class DailyPlan {
        +List~ScheduledItem~ items
        +int total_minutes
        +List~Task~ skipped
        +explain() str
    }

    Owner "1" *-- "1..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : reads constraints from
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" *-- "0..*" ScheduledItem : contains
    ScheduledItem --> Task : wraps
