classDiagram
    %% UML for the final implementation in pawpal_system.py.

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class Owner {
        +str name
        +int available_minutes
        +int day_start_minute
        +dict preferences
        +List~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(name: str) None
        +get_pet(name: str) Pet
        +get_all_tasks() List~Task~
        +get_pending_tasks() List~Task~
    }

    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task_id: str) None
        +get_pending_tasks() List~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +str description
        +Frequency frequency
        +int preferred_minute
        +bool completed
        +date due_date
        +str pet_name
        +str id
        +is_recurring() bool
        +next_occurrence() Task
        +mark_complete() Task
        +reset() None
    }

    class Scheduler {
        +Owner owner
        +tasks_by_pet() Dict~str, List~Task~~
        +complete_task(task: Task) Task
        +find_conflicts(tasks: List~Task~) List~Conflict~
        +conflict_warnings(tasks: List~Task~) List~str~
        +find_plan_conflicts(plan: DailyPlan) List~Conflict~
        +sort_by_time(tasks: List~Task~) List~Task~
        +sort_by_title(tasks: List~Task~) List~Task~
        +filter_tasks(tasks, pet_name, completed) List~Task~
        +build_plan() DailyPlan
        -_sort_tasks(tasks: List~Task~) List~Task~
        -_overlaps(slots) List~Conflict~
        -_first_free_slot(placed, earliest, duration)
        -_reason(task, start, blocker) str
    }

    class Conflict {
        +Task first
        +Task second
        +int start_minute
        +int end_minute
        +same_pet() bool
        +describe() str
    }

    class ScheduledItem {
        +Task task
        +int start_minute
        +str reason
    }

    class SkippedItem {
        +Task task
        +str reason
    }

    class DailyPlan {
        +List~ScheduledItem~ items
        +List~SkippedItem~ skipped
        +total_minutes() int
        +explain() str
    }

    class StreamlitApp {
        <<app.py>>
        +Owner owner
        +Scheduler scheduler
    }

    StreamlitApp --> Owner : keeps in session_state
    StreamlitApp --> Scheduler : sorts, filters, warns, completes, plans
    StreamlitApp ..> Pet : adds pets
    StreamlitApp ..> Task : adds tasks

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Task --> Priority : has
    Task --> Frequency : repeats
    Scheduler --> Owner : reads constraints from
    Scheduler ..> DailyPlan : creates
    Scheduler ..> Conflict : creates
    Scheduler ..> Task : sorts, filters, completes
    Scheduler ..> Pet : complete_task adds next occurrence
    Task ..> Task : next_occurrence() copies
    Conflict --> Task : first / second
    DailyPlan "1" *-- "0..*" ScheduledItem : contains
    DailyPlan "1" *-- "0..*" SkippedItem : contains
    ScheduledItem --> Task : wraps
    SkippedItem --> Task : wraps
